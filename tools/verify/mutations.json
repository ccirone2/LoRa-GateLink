[
 {
  "name": "v_interlock_no_gap_after_release",
  "invariant": "interlock",
  "why": "interlockedPulse ignores the other relay's recent release (gapLeft): a pulse starts 0 ms after the other ended by itself",
  "targets": [
   "esbmc-gate-2",
   "esbmc-gate-4",
   "esbmc-gate-5",
   "esbmc-gate-3",
   "esbmc-gate-1"
  ],
  "edits": [
   {
    "file": "role_gate.cpp",
    "find": "r.pulse(now, ms, wasOn ? INTERLOCK_MS : other.gapLeft(now, INTERLOCK_MS));",
    "replace": "r.pulse(now, ms, wasOn ? INTERLOCK_MS : 0);"
   }
  ]
 },
