{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/tools/agent/hook.sh\" session-start", "timeout": 60}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/tools/agent/hook.sh\" post-edit", "timeout": 90}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/tools/agent/hook.sh\" stop", "timeout": 60}
        ]
      }
    ]
  }
}
